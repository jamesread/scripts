#!/usr/bin/env python3
"""Symlink skill directories from the current directory into Cursor and Claude Code.

Claude Code discovers personal skills at <config dir>/skills/<name>/SKILL.md,
where the config dir is $CLAUDE_CONFIG_DIR if set, otherwise ~/.claude.
"""

from __future__ import annotations

import os
from pathlib import Path

CLAUDE_CONFIG_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")

DEST_ROOTS = [
    Path.home() / ".cursor" / "skills",
    CLAUDE_CONFIG_DIR.expanduser() / "skills",
]


def skill_dirs(skills_root: Path) -> list[Path]:
    dirs: list[Path] = []
    for entry in sorted(skills_root.iterdir()):
        if not entry.is_dir() or entry.name.startswith("."):
            continue
        if (entry / "SKILL.md").is_file():
            dirs.append(entry)
    return dirs


def ensure_symlink(src: Path, dest: Path) -> str:
    if dest.is_symlink():
        current = Path(os.readlink(dest))
        if not current.is_absolute():
            current = (dest.parent / current).resolve()
        if current == src.resolve():
            return "ok"
        dest.unlink()
    elif dest.exists():
        raise FileExistsError(f"{dest} exists and is not a symlink")

    dest.symlink_to(src.resolve())
    return "linked"


def main() -> None:
    skills_root = Path.cwd()
    skills = skill_dirs(skills_root)
    if not skills:
        print(f"No skill directories found in {skills_root}.")
        return

    for dest_root in DEST_ROOTS:
        dest_root.mkdir(parents=True, exist_ok=True)
        for src in skills:
            dest = dest_root / src.name
            try:
                status = ensure_symlink(src, dest)
            except FileExistsError as e:
                print(f"skipped: {e}")
                continue
            print(f"{status}: {dest} -> {src.resolve()}")


if __name__ == "__main__":
    main()
